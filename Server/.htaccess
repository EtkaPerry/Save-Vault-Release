RewriteEngine On

# Pass Authorization header to PHP environment for JWT tokens
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Alternative method to pass the Authorization header
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Redirect direct access to PHP files to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+site/pages/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Prevent direct access to sensitive files and directories
RewriteRule ^site/includes/ - [F,L]
RewriteRule ^\.git/ - [F,L]
RewriteRule ^logs/ - [F,L]

# Block direct web access to PHP files that are include-only (they define
# config/helpers and must never be requested directly). The public API
# entry points (api.php, auth_api.php, *_api.php, index.php) are NOT listed.
RewriteRule ^(config|auth_config|db|db_handler|jwt_helper|ip_utils|secure_file_validator|file_upload|github_monitor|security|secrets)\.php$ - [F,L]

# Block sensitive file types (schema dumps, backups, logs, configs, scripts)
# everywhere except the public download directory.
RewriteCond %{REQUEST_URI} !^/download/
RewriteRule \.(?:git|env|log|lock|md|sql|sqlite|bak|backup|old|orig|swp|inc|ini|sh|yml|yaml|dist|example)$ - [NC,F,L]

# Custom 404 error page

# Redirect site/pages/*.php URLs to clean URLs (only if directly accessed)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+site/pages/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Handle direct access to index.php 
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+site/index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Route all /api/* requests to api.php (changed from auth_api.php to match client expectations)
RewriteRule ^api/(.*)$ api.php [L,QSA]

# Handle clean URLs for pages
RewriteRule ^(privacy-policy|terms-of-service|about|contact|security-policy|download|admin|auth|profile|reset-password)/?$ site/pages/$1.php [L]

# Allow direct access to assets, download directory and .well-known
RewriteRule ^site/download/ - [L]
RewriteRule ^\.well-known/ - [L]
RewriteRule ^(?!download/).*\.json$ - [F,L]

# Handle assets with clean URLs

# Handle downloads with clean URLs

# Default page handler
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Security headers (apply to every response, including errors).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    # Legacy XSS auditor is deprecated and can introduce issues; disable it.
    Header always set X-XSS-Protection "0"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS is ignored by browsers over plain HTTP, so it is safe to send always.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # NOTE: Content-Security-Policy is set per-request in site/includes/header.php
    # because it carries a per-request script nonce ('nonce-...'). It is intentionally
    # NOT set here so the two do not conflict. JSON API responses don't need a CSP.
    # Do not advertise the PHP version (removes the X-Powered-By banner).
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Disable directory listing
Options -Indexes
